{
  "name": "@rific/auto-paper",
  "version": "0.10.0",
  "description": "Adaptive react-native-paper theming: triadic palette from a seed color + system/light/dark appearance",
  "keywords": [
    "react-native",
    "expo",
    "react-native-paper",
    "md3",
    "material-you",
    "material-design",
    "theming",
    "dark-mode",
    "seed-color",
    "color-palette",
    "triadic",
    "adaptive-theme",
    "appearance"
  ],
  "homepage": "https://github.com/jayrdeaton/react-native-auto-paper#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/react-native-auto-paper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/react-native-auto-paper.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "ci": "npm run lint && npm test && npm run typecheck && npm run build",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run ci"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.4",
    "@infinitetoken/tsconfig": "^0.1.1",
    "@reduxjs/toolkit": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-blur": "^56.0.3",
    "expo-navigation-bar": "^56.0.3",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.76.0",
    "react-native-paper": "^5.12.0",
    "react-native-safe-area-context": "^5.5.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo-blur": ">=56.0.0",
    "expo-navigation-bar": ">=56.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0",
    "react-native-paper": ">=5.0.0",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    },
    "expo-navigation-bar": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@reduxjs/toolkit": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
